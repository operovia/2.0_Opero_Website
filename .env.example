# Environment variables for the Opero site.
# Copy to .env.local for local development, or add each one as a Secret in
# Replit (and again in the deployment's secrets when you publish).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. Replit fills this in when you add a database.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# The first admin account, created on first start when no admin exists yet.
# The password needs at least 12 characters. Change it later in the admin.
ADMIN_EMAIL=you@operovia.com
ADMIN_PASSWORD=
ADMIN_NAME=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# The public address of the site, without a trailing slash. Used for links
# in emails, the sitemap, and social previews. On Replit it defaults to the
# app's Replit address when not set.
SITE_URL=https://www.example.com

# Email through Resend (resend.com). Without an API key, emails are printed
# to the server log instead of sent, which is handy while testing.
RESEND_API_KEY=
# Must use the domain you verified in Resend, e.g. a mail.operovia.com subdomain.
EMAIL_FROM=Opero <notifications@mail.operovia.com>
# Optional. Replies go here; defaults to nothing, so replies reach EMAIL_FROM.
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Media uploads
# ---------------------------------------------------------------------------

# With S3_BUCKET empty, uploads are stored in the ./uploads folder. That is
# fine for development but not for a published app: most hosts (including
# Replit deployments) do not keep files written at runtime. For production,
# use any S3-compatible bucket, for example Cloudflare R2 or AWS S3.
S3_BUCKET=
S3_REGION=auto
# Leave empty for AWS S3. For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for storage services that need path-style URLs (for example MinIO).
S3_FORCE_PATH_STYLE=false
# Where uploads are stored when S3_BUCKET is empty.
UPLOADS_DIR=uploads

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Extra hostnames (comma-separated) allowed to submit forms, for setups where
# a proxy forwards a different host than the one in the browser.
ALLOWED_ORIGINS=
# Extra hostnames allowed to load the development server (npm run dev).
ALLOWED_DEV_ORIGINS=
# Maximum database connections per server instance.
DATABASE_POOL_MAX=5
# Only when running several separately built copies of the app behind one
# address: a shared 32-byte base64 key so form actions work across them.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
