# Replit configuration. The site is one standard Next.js app at the
# repository root (see README.md and replit.md); nothing in it depends on
# Replit, and other hosts run the same npm commands.
run = "npm install && npm run dev"
hidden = [".config", ".next", "uploads", ".claude-tools"]
modules = ["nodejs-22", "postgresql-16"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 3000
externalPort = 80

# The Run button: the dev server, the same as `npm run dev` in the Shell.
# Newer Replit workspaces show a Run button only for a workflow. Do not press
# it while a Claude Code session is serving the site (see CLAUDE.md).
[workflows]
runButton = "Site"

[[workflows.workflow]]
name = "Site"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000
