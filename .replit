# Replit configuration. The site is one standard Next.js app at the
# repository root (see README.md and replit.md); nothing in it depends on
# Replit, and other hosts run the same npm commands.
run = "npm install && npm run dev"
hidden = [".config", ".next", "uploads"]
modules = ["nodejs-22", "postgresql-16"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 3000
externalPort = 80
