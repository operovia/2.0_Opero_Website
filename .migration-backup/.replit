# Replit configuration, based on the official Next.js template for Replit.
# Nothing in the app depends on Replit; other hosts use `npm run build` and `npm run start`.
run = "npm install && npm run dev"
hidden = [".config", ".next", "uploads"]
modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 3000
externalPort = 80
