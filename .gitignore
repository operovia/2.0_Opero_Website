# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (anywhere, so leftover folders from other setups never show up as new files)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only the documented example is committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local media uploads (development storage adapter)
/uploads/

# Replit workspace files
/.cache/
/.local/
/.upm/
/.config/

# Claude Code installed by ./cc, with its sign-in and settings: never commit
/.claude-tools/

# Build output from the earlier pnpm workspace setup
dist/

# the website review's layout check screenshots (scripts/check-layout.mjs)
/layout-check/
